# Copy to .env. Expo inlines EXPO_PUBLIC_ vars at build time.
#
# On a PHYSICAL DEVICE, localhost means the device itself — use your computer's
# LAN IP so the phone can reach the API:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
# Android emulator maps the host to 10.0.2.2.
# Defaults to the shared ARLI backend if unset — see src/api.ts.
EXPO_PUBLIC_API_URL=https://project-af-backend.onrender.com
