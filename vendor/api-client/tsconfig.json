{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is required for fetch / Response / RequestInit / AbortController.
    // These exist in browsers, React Native, and Node 18+, so the client runs
    // unchanged on all three surfaces.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "verify.ts"]
}
